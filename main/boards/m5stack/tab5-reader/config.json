{
    "manufacturer": "m5stack",
    "type": "m5stack-tab5-reader",
    "target": "esp32p4",
    "builds": [
        {
            "name": "m5stack-tab5-reader",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_M5STACK_TAB5_READER=y",
                "CONFIG_HAN_DICTIONARY=n",
                "CONFIG_FLASH_NONE_ASSETS=y",
                "CONFIG_WAKE_WORD_DISABLED=y",
                "CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048",
                "CONFIG_LV_USE_KEYBOARD=y",
                "CONFIG_LV_USE_TEXTAREA=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_TINYUSB_MSC_ENABLED=y",
                "CONFIG_TINYUSB_DESC_MSC_STRING=\"Tab5 microSD\"",
                "CONFIG_LVGL_PORT_ENABLE_PPA=y",
                "CONFIG_LV_USE_PPA=y",
                "CONFIG_LV_DRAW_BUF_ALIGN=64",
                "CONFIG_LV_DEF_REFR_PERIOD=16",
                "CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=64",
                "CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y",
                "CONFIG_LV_USE_FONT_COMPRESSED=y",
                "CONFIG_LV_USE_FS_STDIO=y",
                "CONFIG_LV_FS_STDIO_LETTER=83",
                "CONFIG_LV_FS_STDIO_CACHE_SIZE=4096",
                "CONFIG_LV_USE_TJPGD=y",
                "CONFIG_LV_USE_LODEPNG=y",
